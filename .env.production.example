# Root-level env file for BOTH docker-compose.yml (local dev) and
# docker-compose.prod.yml's BUILD ARGS + Docker Compose configuration.
#
# Docker Compose auto-loads a file literally named `.env` in the same directory as
# the compose file to resolve `${VAR}` references — including the `args:` blocks
# under the `app` and `store` services. Copy this to `.env` (not `.env.local` — that
# name is NOT auto-loaded by Compose) before running `docker compose build`/`up`.
#
# The NEXT_PUBLIC_* vars below are inlined into the client-side JS bundle at build
# time. Setting them as runtime `environment:`/`env_file:` values instead does
# nothing; they must be present here, at build time. Runtime-only env vars
# (DATABASE_URL, JWT_SECRET, RAZORPAY_KEY_SECRET, etc.) stay in each app's own
# .env/.env.local (apps/medusa/.env, apps/app/.env.local, apps/store/.env.local),
# loaded via `env_file:` — those never need to be build args since server-side code
# reads them at runtime, not bundle time.

# apps/app
NEXT_PUBLIC_APP_URL=https://app.strengthiva.com
NEXT_PUBLIC_API_URL=https://api.strengthiva.com
# Storefront the nav/footer "Products"/"Supplements" links point at. Must be the
# public store URL, or the build inlines the localhost:3001 fallback.
NEXT_PUBLIC_STORE_URL=https://store.strengthiva.com

# apps/store
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://medusa-store.strengthiva.com
NEXT_PUBLIC_DEFAULT_REGION=in
NEXT_PUBLIC_BASE_URL=https://store.strengthiva.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_STRIPE_KEY=

# --- Docker Compose configuration ---
# Read by docker-compose.yml/docker-compose.prod.yml for variable substitution,
# not by any application code. All have working defaults; only override for a
# port conflict or a specific pinned image version.

# Host-side port bindings (container-side ports are fixed application constants).
MEDUSA_PORT=9000
APP_PORT=3000
STORE_PORT=3001
# docker-compose.yml only (dev) — docker-compose.prod.yml has no local medusa-db.
MEDUSA_DB_PORT=5433
MEDUSA_REDIS_PORT=6379

# Local dev Medusa Postgres credentials (docker-compose.yml's `medusa-db` service
# only — prod uses an external managed Postgres via apps/medusa/.env's
# DATABASE_URL, no local `medusa-db` service).
MEDUSA_DB_USER=medusa
MEDUSA_DB_PASSWORD=medusa
MEDUSA_DB_NAME=medusa

# Pinned image versions — bump deliberately, not by tracking `:latest`.
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

# Must match the same var in strengthiva-backend's and deploy/'s .env files — all
# three compose projects need to agree on one Docker network name to reach each
# other. Only used by docker-compose.prod.yml.
DOCKER_NETWORK=strengthiva_public

# NEXT_PUBLIC_* — inlined into the client bundle at build time. In production these
# must also be passed as Docker build args (see docker-compose.prod.yml and
# .env.production.example at the repo root), not just set here — check-env-variables.js
# also enforces NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY at config-load time.

# Publishable API key for the Medusa backend (Settings > API Key Management in the
# admin dashboard). Required for the storefront to function.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Production: https://medusa-store.strengthiva.com (see 06-deployment-topology.md —
# Medusa's Store API needs its own public subdomain, separate from admin.)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

NEXT_PUBLIC_DEFAULT_REGION=in

# Production: https://store.strengthiva.com
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Optional — only if Stripe is ever enabled alongside/instead of Razorpay.
NEXT_PUBLIC_STRIPE_KEY=

# Must match apps/medusa/.env's RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional — only for Medusa Cloud S3-hosted product images.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

NODE_ENV=production

# Server-only — used by the Cart Bridge and account-page SSO handoff routes.
# Production: https://api.strengthiva.com
FASTAPI_URL=http://localhost:8000

# The assessment app's URL — the footer's "Health Assessment"/"Diet Plans" links
# and the account-page SSO handoff (src/lib/util/env.ts's getAppURL()). NOT
# server-only: like every NEXT_PUBLIC_* above it's inlined at build time, so in
# production it must be a Docker build arg from the repo-root .env, or the
# localhost fallback below is what ships to real users.
# Production: https://app.strengthiva.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

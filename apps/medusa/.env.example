MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
# In production, set these to the real https:// subdomains (app./store./admin.
# strengthiva.com) instead of localhost — see docs/platform-architecture/
# 06-deployment-topology.md for the subdomain list.
STORE_CORS=http://localhost:3001,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3001,http://localhost:3000,https://docs.medusajs.com

# Production: external managed Postgres (DigitalOcean Managed Postgres, its own
# instance separate from FastAPI's — see 02-decisions-log.md). Needs sslmode=require
# since the connection crosses the VPS's network boundary.
DATABASE_URL=postgresql://medusa:medusa@localhost:5433/medusa
# Production: the docker-compose.prod.yml `medusa-redis` service, i.e. redis://medusa-redis:6379
REDIS_URL=redis://localhost:6379

# Generate real values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=

# Shared SSO with app.strengthiva.com — see src/modules/strengthiva-sso.
# FASTAPI_URL: the strengthiva-backend API this Medusa instance validates sessions
# against. Production: https://api.strengthiva.com
FASTAPI_URL=http://localhost:8000
# Must match strengthiva-backend's MEDUSA_SERVICE_KEY env var exactly.
MEDUSA_SERVICE_KEY=

# Razorpay — see src/modules/razorpay and docs/platform-architecture/tech-specs/
# medusa/payments-razorpay.md. key_secret is your API secret (Settings > API Keys);
# webhook_secret is configured separately (Settings > Webhooks) — these are NOT the
# same value, despite the razorpay npm package's own doc-comments conflating them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

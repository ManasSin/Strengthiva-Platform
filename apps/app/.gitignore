# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and the template is exactly that opt-in. It holds only placeholders and
# empty keys, and it is the only record of which variables the app needs —
# strengthiva-backend already tracks its own .env.example the same way.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

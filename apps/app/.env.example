# Shares the same physical Postgres database as strengthiva-backend's DATABASE_URL
# — Better Auth (this app) owns the users table; FastAPI reads it through a
# read-only mirror model (app/models/auth.py::BetterAuthUser). Not two databases.
DATABASE_URL=postgresql://strengthiva:strengthiva@localhost:5432/strengthiva

# Generate a real value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Production: https://app.strengthiva.com
BETTER_AUTH_URL=http://localhost:3000

# NEXT_PUBLIC_* — inlined into the client bundle at build time. In production these
# must also be passed as Docker build args (see docker-compose.prod.yml and
# .env.production.example at the repo root), not just set here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# store.strengthiva.com in production. Backs the "Products"/"Supplements" links in
# the marketing nav and footer (src/lib/site.ts) — these were previously hardcoded
# to localhost and shipped that way.
NEXT_PUBLIC_STORE_URL=http://localhost:3001

# Resend (email verification) — dashboard.resend.com/api-keys. Required in
# production: emailAndPassword.requireEmailVerification is on, so sign-up is
# blocked without a working sender.
RESEND_API_KEY=
# Must be on a domain verified in Resend's dashboard (dashboard.resend.com/domains)
# — an unverified sender fails to send at all, in production or dev.
EMAIL_FROM=Strengthiva <verify@strengthiva.com>

# MSG91 (login/sign-up OTP over SMS) — control.msg91.com. Required in production:
# src/lib/sms.ts refuses to start an OTP send without these when NODE_ENV=production,
# rather than silently degrading to console delivery and locking everyone out.
# Left unset in local dev, the OTP is printed to the server console instead, so the
# whole phone-auth flow is testable without an MSG91 account.
MSG91_AUTH_KEY=
# The DLT-approved template the OTP is sent through. Indian SMS regulation requires
# the template to be registered before it will deliver.
MSG91_TEMPLATE_ID=
# Name of the variable inside that template which carries the code. Must match what
# was approved in the MSG91 dashboard — it is not fixed, hence not hardcoded.
MSG91_OTP_VARIABLE=otp

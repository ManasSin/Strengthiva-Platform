# Build resilience against npm-registry rate-limiting (HTTP 429).
#
# The @medusajs/* scoped packages are numerous and large; a cold `pnpm install`
# in the Docker build (apps/*/Dockerfile do `pnpm install --frozen-lockfile`
# with no warm store) fires many parallel requests and can trip npm's per-IP
# anonymous rate limit — observed 2026-07-30, repeated deploys from the one VPS
# IP failed with ERR_PNPM_FETCH_429 on @medusajs/admin-sdk et al. Low parallelism
# plus long, patient retries keeps installs reliable without a private registry
# mirror. Applied via the build context (Dockerfile COPYs the repo root, and
# pnpm reads .npmrc from the workdir).
network-concurrency=2
fetch-retries=10
fetch-retry-mintimeout=30000
fetch-retry-maxtimeout=180000
fetch-timeout=900000
